# Dependencies. Restored with `npm install`; package-lock.json is tracked.
node_modules/
!package-lock.json

# Harness output. Every screenshot in shots/ is regenerated by `npm run gates`
# (ceremony and probe write 96 of them), so they are build products, not source.
# The two the spec cites as evidence for the shover-safe rule are kept, because
# docs/chain-drift-spec.md points a reader at them.
shots/*
!shots/shover-safe-chase.png
!shots/shover-safe-cleared.png

# Playwright artifacts, if a runner ever writes them here.
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Machine-local Claude Code permissions. .claude/ itself is tracked so shared
# settings can live there.
.claude/settings.local.json

# Logs and scratch.
*.log
npm-debug.log*
yarn-error.log

# Editor and OS noise.
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Deliberately NOT ignored:
#   vendor/  - crisp-game-lib ships with the cabinet on purpose. Loading it from
#              a CDN once made every page load and every gate depend on a third
#              party being up; tools/probe.mjs now fails if anything is fetched
#              off-origin. Keep the bundle in the repo.
#   assets/source/ - generation inputs and provenance for the logo sprite.
#   package-lock.json
